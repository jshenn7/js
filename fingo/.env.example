# Optional cloud LLM providers (used instead of local Ollama when set)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Local Ollama (default)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=moondream

# Google sign-in (optional — without these the Google button uses a demo account)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-origin>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
